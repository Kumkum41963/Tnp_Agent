# ============================================================
# TNP Automation Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Ollama (Local LLM & Embedding server) ─────────────────
# URL of your external Ollama server.
# Example: http://your-server-ip:11434
OLLAMA_BASE_URL=http://localhost:11434

# Main chat/reasoning model served by Ollama.
# Recommended: llama3.1, mistral, gemma2, or any Ollama-supported model.
OLLAMA_MODEL=llama3.1

# Embedding model served by Ollama (used for semantic column mapping).
# Pull with: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── LLM Inference Settings ────────────────────────────────
# Temperature for structured (schema/validation) agents — keep low for determinism.
LLM_TEMPERATURE=0.1
# Temperature for reminder/text generation agents.
LLM_REMINDER_TEMPERATURE=0.3
# Max tokens for LLM responses.
LLM_MAX_TOKENS=2048
# Timeout for a single LLM call (seconds).
LLM_TIMEOUT_SECONDS=60

# ─── Pipeline Thresholds ──────────────────────────────────
# Column mapping: confidence below this → needs_human_review
COLUMN_MAPPING_CONFIDENCE_THRESHOLD=0.7
# Resume identity: confidence below this → needs_human_review
IDENTITY_CONFIDENCE_THRESHOLD=0.75
# Schema agent: if fraction of columns below threshold exceeds this, retry
SCHEMA_AGENT_LOW_CONFIDENCE_FRACTION=0.3
# Max automatic retries for the Schema Agent
SCHEMA_AGENT_MAX_RETRIES=2

# ─── Storage ──────────────────────────────────────────────
# Base directory for run data (uploads, outputs, state).
DATA_DIR=./data
# ChromaDB persistence directory.
CHROMA_PERSIST_DIR=./app/storage/chroma_store

# ─── Google APIs (optional — stub active by default) ───────
# Set GOOGLE_INTEGRATION_ENABLED=true to activate the real Google integration.
# Requires a service account JSON for Drive access, plus OAuth client secrets/token for Forms API.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google_service_account.json
GOOGLE_OAUTH_CLIENT_FILE=./oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=./token.json
# Google Drive folder ID where uploaded resumes will be stored.
GOOGLE_DRIVE_FOLDER_ID=

# ─── API Server ────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
